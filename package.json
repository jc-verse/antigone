{
  "name": "antigone",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun server.ts",
    "build": "bun --bun remix vite:build && bun build --target=bun --outdir=build/bin app/runpod_client.ts app/runpod_provisioner.ts",
    "start": "NODE_ENV=production bun server.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "lint": "bun --bun eslint . --max-warnings 0",
    "lint:fix": "bun --bun eslint . --fix"
  },
  "dependencies": {
    "@remix-run/node": "2.17.5",
    "@remix-run/react": "2.17.5",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@remix-run/express": "2.17.5",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.2",
    "express": "^4.21.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "prettier": "prettier-config-jc",
  "devDependencies": {
    "eslint": "^10.11.0",
    "eslint-config-jc": "^7.2.0",
    "prettier": "^3.9.9",
    "prettier-config-jc": "^3.0.0",
    "@remix-run/dev": "2.17.5",
    "@types/bun": "^1.4.2",
    "@types/express": "^4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "tsconfig-jc": "^2.3.1",
    "typescript": "~6.0.0",
    "vite": "^6.4.0"
  },
  "bin": {
    "antigone-generate": "./build/bin/runpod_client.js",
    "antigone-provision": "./build/bin/runpod_provisioner.js"
  }
}
