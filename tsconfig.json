{
  "extends": "tsconfig-jc",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["bun", "vite/client"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "importsNotUsedAsValues": null
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "build"]
}
