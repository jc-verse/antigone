# Local configuration and secrets. Copy to .env and fill in your values.

# Generate an initial password with: openssl rand -hex 32
# Sign in once, then set a replacement password, configure an authenticator app,
# and register a passkey at /auth/manage. Saving the replacement password disables
# this initial password. Later sign-ins use password + authenticator code or a passkey.
INIT_PASSWORD=

# Generate once with: openssl rand -hex 32. Keep stable across restarts.
# Protects auth cookies, authenticator secrets, and recovery codes.
BETTER_AUTH_SECRET=

# Used for passkey RP ID
APP_ORIGIN=http://localhost:4410

# Required for GPU setup
RUNPOD_API_KEY=

# Optional override; defaults to ghcr.io/jc-verse/antigone-comfyui:v0.38.0-1
RUNPOD_IMAGE=

# Required if RUNPOD_IMAGE is private; the token must have read:packages scope
GHCR_USERNAME=
GHCR_TOKEN=

# Required if you want to download models from CivitAI
CIVITAI_KEY=

# Optional authenticated Hugging Face downloads
HF_TOKEN=
